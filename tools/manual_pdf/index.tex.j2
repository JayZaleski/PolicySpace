((=- The manual's PDF template: manual.ipynb -> LaTeX -> manual.pdf.

The PDF is the same manual as manual.html in print form, so this template
follows manual.css: the same colors, the next fonts in its stacks that Windows
ships (Cambria for text, Consolas for code), the rule above every section,
the washed code blocks and the left-marked notebook output. Markdown cells go
through pandoc with tools/manual_pdf/manual.lua, which turns the notebook's
heading levels and link anchors into LaTeX sections and labels. The Contents
cell becomes a LaTeX table of contents. -=))

((*- extends 'base.tex.j2' -*))

((* block docclass *))\documentclass[11pt,letterpaper]{article}((* endblock docclass *))

((* block packages *))
((( super() )))
    \usepackage[skip=7pt plus 2pt]{parskip}
    \usepackage{titlesec}
    \usepackage{fancyhdr}
    \usepackage{setspace}
    \usepackage{needspace}
    \usepackage[protrusion=true,expansion=false]{microtype}
    \usepackage{tcolorbox}
    \tcbuselibrary{breakable,skins}
((* endblock packages *))

((* block definitions *))
((( super() )))
    % ---- The manual's palette, from manual.css ----------------------------
    \definecolor{ink}{HTML}{1F2D3D}
    \definecolor{muted}{HTML}{5F6D7B}
    \definecolor{rule}{HTML}{D5DDE5}
    \definecolor{wash}{HTML}{F2F5F8}
    \definecolor{link}{HTML}{1B5C9C}
    \definecolor{mark}{HTML}{B4452C}
    \definecolor{urlcolor}{HTML}{1B5C9C}
    \definecolor{linkcolor}{HTML}{1B5C9C}
    \definecolor{citecolor}{HTML}{1B5C9C}

    % ---- Fonts: manual.css's stacks, as Windows ships them ----------------
    \setmainfont{Cambria}[Scale=0.95]
    \setmonofont{Consolas}[Scale=MatchLowercase,HyphenChar=None]
    \setstretch{1.08}
    \urlstyle{same}
    % Links to docs/ are set as URLs: let them also break at hyphens.
    \def\UrlBreaks{\do\.\do\@\do\\\do\/\do\!\do\_\do\|\do\;\do\>\do\]\do\)\do\,\do\?\do\&\do\'\do+\do\=\do\#\do\-}

    % ---- Headings: unnumbered, ink, a rule above each section -------------
    \setcounter{secnumdepth}{0}
    \setcounter{tocdepth}{3}
    \titleformat{\section}
      {\needspace{8\baselineskip}{\color{rule}\titlerule[0.5pt]}\vspace{14pt}%
       \color{ink}\bfseries\fontsize{17}{20}\selectfont}{}{0pt}{}
    \titleformat{\subsection}
      {\color{ink}\bfseries\fontsize{13}{16}\selectfont}{}{0pt}{}
    \titleformat{\subsubsection}
      {\color{ink}\bfseries\fontsize{11}{14}\selectfont}{}{0pt}{}
    \titlespacing*{\section}{0pt}{34pt plus 6pt minus 4pt}{9pt}
    \titlespacing*{\subsection}{0pt}{22pt plus 4pt minus 2pt}{5pt}
    \titlespacing*{\subsubsection}{0pt}{16pt plus 3pt minus 2pt}{3pt}

    % ---- Running header and footer ----------------------------------------
    \pagestyle{fancy}
    \fancyhf{}
    \renewcommand{\headrulewidth}{0pt}
    \fancyhead[L]{\color{muted}\small PolicySpace Manual}
    \fancyhead[R]{\color{muted}\small\nouppercase{\leftmark}}
    \fancyfoot[C]{\color{muted}\small\thepage}
    \fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\color{muted}\small\thepage}}

    % ---- Lists --------------------------------------------------------------
    \setlist{itemsep=3pt,parsep=0pt,topsep=4pt,leftmargin=1.4em}
    \setlist[itemize]{label=\textcolor{muted}{\textbullet}}

    % ---- Tables: left-aligned, a strong rule under the header ---------------
    % pandoc wraps each table in \def\LTcaptype{none}; with the caption
    % package loaded, longtable then wants a counter by that name.
    \newcounter{none}
    \newcommand{\tablefont}{\small}
    \newcommand{\tablefontwide}{\footnotesize}
    \setlength{\LTleft}{0pt}
    \setlength{\LTright}{\fill}
    \setlength{\LTpre}{8pt}
    \setlength{\LTpost}{12pt}
    \renewcommand{\arraystretch}{1.3}
    \setlength{\heavyrulewidth}{0.8pt}
    \setlength{\lightrulewidth}{0.4pt}
    \setlength{\aboverulesep}{0.5ex}
    \setlength{\belowrulesep}{0.7ex}

    % ---- Code blocks in Markdown cells: a washed box, few colors ------------
    \DefineVerbatimEnvironment{Highlighting}{Verbatim}{commandchars=\\\{\},fontsize=\small}
    \renewenvironment{Shaded}
      {\begin{tcolorbox}[breakable,enhanced,colback=wash,colframe=wash,boxrule=0pt,arc=2pt,
         left=8pt,right=8pt,top=5pt,bottom=5pt,before skip=8pt,after skip=12pt]}
      {\end{tcolorbox}}
    \renewcommand{\StringTok}[1]{\textcolor{mark}{#1}}
    \renewcommand{\VerbatimStringTok}[1]{\textcolor{mark}{#1}}
    \renewcommand{\SpecialStringTok}[1]{\textcolor{mark}{#1}}
    \renewcommand{\CommentTok}[1]{\textcolor{muted}{\textit{#1}}}
    \renewcommand{\OperatorTok}[1]{\textcolor{muted}{#1}}
    \renewcommand{\KeywordTok}[1]{\textcolor{ink}{#1}}
    \renewcommand{\DataTypeTok}[1]{\textcolor{ink}{#1}}
    \renewcommand{\DecValTok}[1]{\textcolor{ink}{#1}}
    \renewcommand{\FloatTok}[1]{\textcolor{ink}{#1}}
    \renewcommand{\BaseNTok}[1]{\textcolor{ink}{#1}}
    \renewcommand{\OtherTok}[1]{\textcolor{ink}{#1}}
    \renewcommand{\AttributeTok}[1]{\textcolor{ink}{#1}}
    \renewcommand{\VariableTok}[1]{\textcolor{ink}{#1}}
    \renewcommand{\ConstantTok}[1]{\textcolor{ink}{#1}}
    \renewcommand{\FunctionTok}[1]{\textcolor{ink}{#1}}
    \renewcommand{\ControlFlowTok}[1]{\textcolor{ink}{#1}}
    \renewcommand{\SpecialCharTok}[1]{\textcolor{ink}{#1}}
    \renewcommand{\CharTok}[1]{\textcolor{mark}{#1}}
    \renewcommand{\PreprocessorTok}[1]{\textcolor{ink}{#1}}

    % ---- Text a code cell printed: washed, marked at the left edge ----------
    \newtcolorbox{streambox}{breakable,enhanced,colback=wash,colframe=wash,boxrule=0pt,arc=0pt,
      borderline west={2pt}{0pt}{rule},left=8pt,right=6pt,top=4pt,bottom=4pt,
      before skip=8pt,after skip=12pt}
((* endblock definitions *))

((* block title *))\title{PolicySpace Manual}((* endblock title *))

((* block commands *))
((( super() )))
    \hypersetup{pdftitle={PolicySpace Manual},bookmarksnumbered=false,bookmarksopen=true}
    \fussy
    \setlength{\emergencystretch}{2.5em}
    \hyphenpenalty=300
    \color{ink}
((* endblock commands *))

((* block margins *))
    \geometry{letterpaper,textwidth=5.6in,top=1.1in,bottom=1.15in,hcentering,headsep=22pt,footskip=30pt}
((* endblock margins *))

((* block maketitle *))
    \thispagestyle{plain}
    {\color{ink}\bfseries\fontsize{28}{32}\selectfont PolicySpace Manual\par}
    \vspace{14pt}
((* endblock maketitle *))

((=- Markdown cells: the Contents cell becomes LaTeX's table of contents; every
other cell goes through pandoc with the manual's filter. -=))
((* block markdowncell scoped *))
((*- if cell.source.lstrip().startswith('## Contents') -*))
    {\hypersetup{linkcolor=ink}\tableofcontents}
((*- else -*))
    ((( cell.source | citation2latex | strip_files_prefix | convert_pandoc('markdown+tex_math_double_backslash', 'json', extra_args=[]) | convert_explicitly_relative_paths | convert_pandoc('json', 'latex', extra_args=['--lua-filter=tools/manual_pdf/manual.lua']) )))
((*- endif -*))
((* endblock markdowncell *))

((=- Figures sit at the left margin, like the HTML's. -=))
((*- block figure scoped -*))
    \par\noindent\adjustimage{max width=\linewidth,max height=0.8\textheight}{((( filename )))}\par
    \vspace{6pt}
((*- endblock figure -*))

((=- Text a code cell printed, wrapped to the box. -=))
((* block stream *))
    \begin{streambox}
    \begin{Verbatim}[commandchars=\\\{\},fontsize=\footnotesize]
((( output.text | wrap_text(84) | escape_latex | strip_trailing_newline | ansi2latex )))
    \end{Verbatim}
    \end{streambox}
((* endblock stream *))

((=- The CSS cell's output is HTML; its text/plain stand-in is noise. -=))
((* block data_text *))
((*- if not output.data['text/plain'].startswith('<IPython') -*))
((( super() )))
((*- endif -*))
((* endblock data_text *))
